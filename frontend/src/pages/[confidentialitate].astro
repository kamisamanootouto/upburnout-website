---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { confidentialitate as c, PRIVACY_ENABLED } from '../data/confidentialitate';

// Rută dinamică cu o singură cale (/confidentialitate), ca pagina să poată fi scoasă complet din build
// (fără fișier HTML, fără intrare în sitemap) când PRIVACY_ENABLED = false — vezi src/data/confidentialitate.ts.
export function getStaticPaths() {
  return PRIVACY_ENABLED ? [{ params: { confidentialitate: c.path.slice(1) } }] : [];
}
---

<Base title={`${c.title} | ${site.name}`} path={c.path} description={c.intro}>
  <article class="container-site py-14 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <h1 class="h-section">{c.title}</h1>
      <p class="text-ink-muted mt-3 text-[0.9375rem]">Ultima actualizare: {c.updated}</p>
      <p class="lead mt-8">{c.intro}</p>
      {
        c.sections.map((s) => (
          <section class="mt-10">
            <h2 class="font-display text-ink text-[1.375rem] leading-snug font-semibold">
              {s.heading}
            </h2>
            <div class="prose-site text-ink-soft mt-4 text-[1.0625rem] leading-[1.7]">
              {s.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        ))
      }
      <p class="mt-12">
        <a href="/#contact" class="btn btn-secondary">Înapoi la formularul de contact</a>
      </p>
    </div>
  </article>
</Base>
