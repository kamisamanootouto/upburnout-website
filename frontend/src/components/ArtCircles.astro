---
/* „Grup” — cercuri translucide care se suprapun; ecou abstract al terapiei de grup. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 520 360" class={className} aria-hidden="true" focusable="false">
  <g style="mix-blend-mode: multiply">
    <circle cx="150" cy="190" r="120" fill="#e4f2f3"></circle>
    <circle cx="260" cy="150" r="120" fill="#eeedfb"></circle>
    <circle cx="370" cy="190" r="120" fill="#e9f0fa"></circle>
    <circle cx="205" cy="250" r="90" fill="#e4f2f3"></circle>
    <circle cx="315" cy="250" r="90" fill="#eeedfb"></circle>
  </g>
  <g fill="none" stroke="#2f7c86" stroke-opacity="0.35" stroke-width="1.5">
    <circle cx="150" cy="190" r="120"></circle>
    <circle cx="260" cy="150" r="120"></circle>
    <circle cx="370" cy="190" r="120"></circle>
  </g>
  <g fill="#14213d" fill-opacity="0.55">
    <circle cx="150" cy="190" r="5"></circle>
    <circle cx="260" cy="150" r="5"></circle>
    <circle cx="370" cy="190" r="5"></circle>
    <circle cx="205" cy="250" r="5"></circle>
    <circle cx="315" cy="250" r="5"></circle>
  </g>
</svg>
