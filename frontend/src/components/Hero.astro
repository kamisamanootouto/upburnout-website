---
import { Image } from 'astro:assets';
import logo from '../assets/logo-uvt-fpse.png';
import heroArt from '../assets/illustrations/hero-femeie-plante.jpg';
import { hero } from '../data/acasa';
---

<section class="relative overflow-hidden">
  <div
    class="container-site grid items-center gap-10 pt-10 pb-16 sm:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pt-20 lg:pb-24"
  >
    <div class="max-w-2xl">
      <Image
        src={logo}
        alt={hero.logoAlt}
        widths={[220, 440]}
        sizes="220px"
        class="h-auto w-[200px] sm:w-[220px]"
        loading="eager"
      />
      <h1 class="h-display mt-8">{hero.title}</h1>
      <p class="lead mt-6 max-w-xl">{hero.subtitle}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={hero.ctaHref} class="btn btn-primary">{hero.cta}</a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[520px] lg:max-w-none">
      <!-- Ilustrația originală de pe Wix (Vecteezy), afișată ca acolo: portret, decupată centrat -->
      <Image
        src={heroArt}
        alt=""
        widths={[480, 720, 1080, 1400]}
        sizes="(min-width: 1024px) 45vw, (min-width: 640px) 520px, 90vw"
        class="aspect-[11/12] h-auto w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
