---
import { Image } from 'astro:assets';
import art from '../assets/illustrations/participare-cap-creier.jpg';
import { participare } from '../data/acasa';
---

<section class="py-16 sm:py-20 lg:py-24" aria-labelledby="participare-titlu">
  <div class="container-site">
    <h2 id="participare-titlu" class="h-section reveal max-w-3xl">{participare.title}</h2>

    <div class="mt-10 grid items-center gap-10 lg:mt-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12">
      <div class="reveal mx-auto w-full max-w-[440px] lg:mx-0 lg:max-w-[520px]">
        <Image
          src={art}
          alt=""
          widths={[440, 660, 900]}
          sizes="(min-width: 1024px) 520px, 440px"
          class="h-auto w-full"
          loading="lazy"
        />
      </div>
      <ol class="flex flex-wrap justify-center gap-x-12 gap-y-2">
        {
          participare.steps.map((text, i) => (
            <li class="reveal relative flex w-full gap-5 py-5 md:w-[calc(50%-1.5rem)]">
              <span
                class="num-badge bg-ink text-surface font-display grid size-10 shrink-0 place-items-center rounded-full text-[0.9375rem] font-bold tabular-nums"
                data-num={i + 1}
                aria-hidden="true"
              />
              <span class="sr-only">{`${i + 1}. `}</span>
              <p class="text-ink pt-1.5 text-[1.0625rem] leading-relaxed">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
