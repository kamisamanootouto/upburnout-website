---
/* „Etape” — trepte ascendente, calm; pentru „Scopul cercetării” (fezabilitate → acceptabilitate → îmbunătățire). */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 520 380" class={className} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="s-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e4f2f3"></stop>
      <stop offset="100%" stop-color="#f4f7fb"></stop>
    </linearGradient>
  </defs>
  <rect x="40" y="250" width="96" height="90" rx="18" fill="url(#s-fade)"></rect>
  <rect x="152" y="200" width="96" height="140" rx="18" fill="#eeedfb"></rect>
  <rect x="264" y="150" width="96" height="190" rx="18" fill="#e9f0fa"></rect>
  <rect x="376" y="100" width="96" height="240" rx="18" fill="#e4f2f3"></rect>
  <g fill="none" stroke="#2f7c86" stroke-opacity="0.45" stroke-width="1.5">
    <rect x="40" y="250" width="96" height="90" rx="18"></rect>
    <rect x="152" y="200" width="96" height="140" rx="18"></rect>
    <rect x="264" y="150" width="96" height="190" rx="18"></rect>
    <rect x="376" y="100" width="96" height="240" rx="18"></rect>
  </g>
  <path
    d="M88 226 C 160 210, 220 160, 312 126 S 400 70, 424 62"
    fill="none"
    stroke="#14213d"
    stroke-opacity="0.35"
    stroke-width="2"
    stroke-dasharray="6 8"
    stroke-linecap="round"></path>
  <circle cx="424" cy="62" r="9" fill="#2f7c86" fill-opacity="0.9"></circle>
  <circle cx="88" cy="226" r="5" fill="#14213d" fill-opacity="0.5"></circle>
  <circle cx="200" cy="174" r="5" fill="#14213d" fill-opacity="0.5"></circle>
  <circle cx="312" cy="126" r="5" fill="#14213d" fill-opacity="0.5"></circle>
</svg>
