---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  /** calea canonică, ex. "/" sau "/echipă" */
  path: string;
  /**
   * Meta description — EXCLUSIV o propoziție existentă pe pagină (regula „zero text adăugat”,
   * docs/OPEN_QUESTIONS.md #2). Fără ea nu se emite meta description.
   */
  description?: string;
  /** pagina curentă pentru marcarea în meniu */
  current?: '/' | '/echipă';
  /** doar pentru pagini care nu trebuie indexate (404) */
  noindex?: boolean;
}

const { title, path, description, current, noindex = site.noindex } = Astro.props;
// Canonicalul păstrează `www` și forma cu diacritic percent-encodată, ca pe Wix.
const canonical = site.canonicalOrigin + (path === '/' ? '/' : encodeURI(path));
const ogImage = site.canonicalOrigin + site.ogImage;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.canonicalOrigin + '/',
    inLanguage: 'ro',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: canonical,
    inLanguage: 'ro',
    ...(description ? { description } : {}),
    isPartOf: { '@type': 'WebSite', name: site.name, url: site.canonicalOrigin + '/' },
  },
];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-svh flex-col">
    <a href="#continut" class="sr-only-focusable btn btn-primary btn-sm fixed top-3 left-3 z-[100]">
      Sari la conținut
    </a>
    <Header current={current} />
    <main id="continut" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
