{
  "name": "upburnout-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node scripts/prepare-images.mjs",
    "verify-content": "node scripts/verify-content.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.3.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260920.1",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "sharp@0.35.4": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260918.1": true
  }
